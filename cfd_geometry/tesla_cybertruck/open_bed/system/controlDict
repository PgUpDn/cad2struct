FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          incompressibleFluid;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         5000;

deltaT          1;

writeControl    timeStep;

writeInterval   20;

purgeWrite      1;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    // residuals
    # includeFunc residuals(U, p, k, omega);

    // Q criterion
    # includeFunc Q

    // Lambda2 criterion
    # includeFunc Lambda2
    
	// isoSurface of Q
    # includeFunc isoSurface
    (
        isoField = Q,
        isoValue = 100,
        writeEmpty = no
    )
    
	# includeFunc isoSurface
    (
        isoField = Q,
        isoValue = 200,
        writeEmpty = no
    )
	
	# includeFunc isoSurface
    (
        isoField = Q,
        isoValue = 500,
        writeEmpty = no
    )
	
	# includeFunc isoSurface
    (
        isoField = Q,
        isoValue = 1000,
        writeEmpty = no
    )

	// isoSurface of Lambda2
	# includeFunc isoSurface
    (
        isoField = Lambda2,
        isoValue = -10000,
        writeEmpty = no
    )

    // Vorticity
    # includeFunc vorticity

	// Y Plus
    yPlus
    {
        type    yPlus;
        libs    ("libfieldFunctionObjects.so");

        writeControl    writeTime;
    }
	
	// Wall Shear Stress
	wallShearStress
    {
        type            wallShearStress;
        libs            ("libfieldFunctionObjects.so");

        executeControl  timeStep;
        writeControl    writeTime;
    }

    fieldAverage1
    {
        type        fieldAverage;
        libs        (fieldFunctionObjects);

        fields
        (
            U
            {
                mean        yes;
                base        time;
                allowRestart        true;
            }
            p
            {
                mean        yes;
                base        time;
                allowRestart        true;
            }
            k
            {
                mean        yes;
                base        time;
                allowRestart        true;
            }
            epsilon
            {
                mean        yes;
                base        time;
                allowRestart        true;
            }
            Q
            {
                mean        yes;
                base        time;
                allowRestart        true;
            }
            Lambda2
            {
                mean        yes;
                base        time;
                allowRestart        true;
            }
            yPlus
            {
                mean        yes;
                base        time;
                allowRestart        true;
            }
            vorticity
            {
                mean        yes;
                base        time;
                allowRestart        true;
            }
        );

        restartOnRestart        true;
        enabled        true;
        log        true;

		//timeStart			1000;

        executeControl        timeStep;
        writeControl        writeTime;
    }

    // cutting planes in the wake
    slices
    {
        type    surfaces;
        libs    ("libsampling.so");

        executeControl        writeTime;
        writeControl    writeTime;

        surfaceFormat    vtk;
        interpolationScheme    cellPoint;

        fields (p U k omega yPlus Q Lambda2);

        surfaces
        (
            cutPlane01
            {
                type   cutPlane;
                interpolate    true;
                planeType    pointAndNormal;
                point    (0 -0.001 0);
                normal    (0 1 0);
            }

            cutPlane02
            {
                type   cutPlane;
                interpolate    true;
                planeType    pointAndNormal;
                point    (0 -0.835 0);
                normal    (0 1 0);
            }

            cutPlane1
            {
                type    cutPlane;
                interpolate    true;
                planeType    pointAndNormal;
                point    (2 0 0);
                normal    (1 0 0);
            }

            cutPlane2
            {
                type    cutPlane;
                interpolate    true;
                planeType    pointAndNormal;
                point    (0 0 0);
                normal    (1 0 0);
            }

            cutPlane3
            {
                type    cutPlane;
                interpolate    true;
                planeType    pointAndNormal;
                normal    (1 0 0);
                point    (-2 0 0);
            }

            cutPlane4
            {
                type    cutPlane;
                interpolate    true;
                planeType    pointAndNormal;
                normal    (1 0 0);
                point    (-3 0 0);
            }

            cutPlane5
            {
                type    cutPlane;
